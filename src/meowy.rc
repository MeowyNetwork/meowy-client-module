// Icons bundled in gmcl_meowy for the notifications (notify_toast.cpp).
// Drawn by assets/make_icon.ps1. The icon is the DLL's first, so the
// installer's Start-menu shortcut uses it as "gmcl_meowy_win64.dll,0".
#include "resource.h"

IDI_MEOWY ICON "../assets/meowy.ico"
IDR_NOTIFY_PNG RCDATA "../assets/notify.png"
// Connection resilience's menu Lua, kept as .lua files so tests/resilience_logic_test.lua
// and luac -p can read them; module.cpp joins and runs them.
IDR_RESILIENCE_LOGIC_LUA RCDATA "lua/resilience_logic.lua"
IDR_RESILIENCE_LUA RCDATA "lua/resilience.lua"
