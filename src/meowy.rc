// Icons bundled in gmcl_meowy for the notifications (notify_toast.cpp).
// Drawn by assets/make_icon.ps1. The icon is the DLL's first, so the
// installer's Start-menu shortcut uses it as "gmcl_meowy_win64.dll,0".
#include "resource.h"

// The pack's version (version.h), readable from the file (GetFileVersionInfo).
#define MEOWY_FILE_DESCRIPTION "Meowy Client Pack"
#include "version.rc"

IDI_MEOWY ICON "../assets/meowy.ico"
IDR_NOTIFY_PNG RCDATA "../assets/notify.png"
// Connection resilience's menu Lua, kept as .lua files so tests/resilience_logic_test.lua
// and luac -p can read them; module.cpp joins and runs them.
IDR_RESILIENCE_LOGIC_LUA RCDATA "lua/resilience_logic.lua"
IDR_RESILIENCE_LUA RCDATA "lua/resilience.lua"
IDR_DOCTOR_LOGIC_LUA RCDATA "lua/doctor_logic.lua"
IDR_DOCTOR_LUA RCDATA "lua/doctor.lua"
IDR_UI_LUA RCDATA "lua/ui.lua"
IDR_HOME_LOGIC_LUA RCDATA "lua/home_logic.lua"
IDR_HOME_LUA RCDATA "lua/home.lua"
IDR_MENU_PAGE_LUA RCDATA "lua/menu_page.lua"
IDR_MENU_SHELL_JS RCDATA "menu/shell.js"
IDR_CONSOLE_LOGIC_LUA RCDATA "lua/console_logic.lua"
IDR_CONSOLE_LUA RCDATA "lua/console.lua"
IDR_MENU_BROWSER_JS RCDATA "menu/browser.js"
IDR_SETTINGS_GUARD_LOGIC_LUA RCDATA "lua/settings_guard_logic.lua"
IDR_SETTINGS_GUARD_LUA RCDATA "lua/settings_guard.lua"
IDR_CONTENT_LOGIC_LUA RCDATA "lua/content_logic.lua"
IDR_BROWSE_LOGIC_LUA RCDATA "lua/browse_logic.lua"
IDR_PARTY_LOGIC_LUA RCDATA "lua/party_logic.lua"
IDR_PARTY_LUA RCDATA "lua/party.lua"
